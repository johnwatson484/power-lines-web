# Native app settings. Keep RabbitMQ values identical in both repositories.
DOTNET_ENVIRONMENT=Development
Message__Host=localhost
Message__Port=5672
Message__Username=rabbitmq
Message__Password=rabbitmq
Message__FixtureQueue=fixtures
Message__ResultQueue=results
RABBITMQ_MANAGEMENT_PORT=15672
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__PowerLinesWeb="Host=localhost;Port=6000;Database=power_lines_web;Username=postgres;Password=postgres"
Message__FixtureSubscription=fixtures-web
Message__ResultSubscription=results-web
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Keep the native connection string in sync if changing these values.
POSTGRES_DB=power_lines_web
POSTGRES_PORT=6000
Workers__Enabled=true
Feed__FixtureTimeZoneId=Europe/London
