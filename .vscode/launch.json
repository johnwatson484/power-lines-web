{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev: native",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build",
      "program": "${workspaceFolder}/bin/PowerLinesWeb/Debug/net10.0/PowerLinesWeb.dll",
      "cwd": "${workspaceFolder}/PowerLinesWeb",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "args": [],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Docker: Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "power-lines-web"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/home/dotnet": "${workspaceFolder}"
      }
    }
  ]
}
