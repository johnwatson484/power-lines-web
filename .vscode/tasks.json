{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Services: Up",
      "type": "shell",
      "command": "./scripts/services-up",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Services: Down",
      "type": "shell",
      "command": "./scripts/services-down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev",
      "type": "shell",
      "command": "./scripts/dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Local",
      "type": "shell",
      "command": "./scripts/local",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "dotnet build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "dotnet test --collect:\"XPlat Code Coverage\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test: Unit",
      "type": "shell",
      "command": "dotnet test --filter TestCategory!=Integration",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test: Watch",
      "type": "shell",
      "command": "dotnet watch --project PowerLinesWeb.Tests test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Docker: Build",
      "type": "shell",
      "command": "docker compose --profile app build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Dev",
      "type": "shell",
      "command": "docker compose --profile app up --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
