@model List<PowerLinesWeb.Models.Accuracy>

@if (Model == null || Model.Count == 0)
{
    <h3>Insufficient data for analysis...</h3>
}
else
{
    <h3>Accuracy</h3>

    <table class="table table-condensed table-hover table-sm">
        <tr>
            <th class="no-mobile">@Html.DisplayNameFor(model => model[0].Country)</th>
            <th>@Html.DisplayNameFor(model => model[0].Division)</th>
            <th class="text-center no-mobile">@Html.DisplayNameFor(model => model[0].Matches)</th>
            <th class="text-center no-mobile">@Html.DisplayNameFor(model => model[0].Recommended)</th>
            <th class="text-center" data-toggle="tooltip" title="Hit rate when the model's top pick clears the higher confidence threshold">@Html.DisplayNameFor(model => model[0].RecommendedAccuracy)</th>
            <th class="text-center no-mobile">@Html.DisplayNameFor(model => model[0].LowerRecommended)</th>
            <th class="text-center" data-toggle="tooltip" title="Hit rate when the model's top pick clears only the lower confidence threshold">@Html.DisplayNameFor(model => model[0].LowerRecommendedAccuracy)</th>
            <th class="text-center no-mobile" data-toggle="tooltip" title="Always backing the home side, the do-nothing baseline any recommendation has to beat">@Html.DisplayNameFor(model => model[0].BaselineAccuracy)</th>
            <th class="text-center no-mobile" data-toggle="tooltip" title="How well calibrated the model's probabilities are, not just whether the top pick won. Lower is better.">@Html.DisplayNameFor(model => model[0].LogLoss)</th>
            <th class="text-center no-mobile" data-toggle="tooltip" title="The same measure for the bookmakers' own de-margined prices &mdash; the bar the model has to beat">@Html.DisplayNameFor(model => model[0].MarketLogLoss)</th>
            <th class="text-center no-mobile" data-toggle="tooltip" title="Another calibration measure, penalising confident wrong calls more than log loss">@Html.DisplayNameFor(model => model[0].BrierScore)</th>
            <th class="text-center no-mobile" data-toggle="tooltip" title="Wins / total bets flagged as Value in backtest &mdash; a hit rate, not a profit figure">@Html.DisplayNameFor(model => model[0].ValueBets)</th>
            <th class="text-center" data-toggle="tooltip" title="Return from level stakes on every Value selection, backtested &mdash; currently negative in most leagues">@Html.DisplayNameFor(model => model[0].ValueRoi)</th>
        </tr>
        @foreach (var division in Model)
        {
          <tr>
            <td class="no-mobile">@Html.DisplayFor(modelItem => division.Country)</td>
            <td>@Html.DisplayFor(modelItem => division.Division)</td>
            <td class="text-center no-mobile">@Html.DisplayFor(modelItem => division.Matches)</td>
            <td class="text-center no-mobile">@Html.DisplayFor(modelItem => division.Recommended)</td>
            <td class="text-center">@Html.DisplayFor(modelItem => division.RecommendedAccuracy)</td>
            <td class="text-center no-mobile">@Html.DisplayFor(modelItem => division.LowerRecommended)</td>
            <td class="text-center">@Html.DisplayFor(modelItem => division.LowerRecommendedAccuracy)</td>
            <td class="text-center no-mobile">@Html.DisplayFor(modelItem => division.BaselineAccuracy)</td>
            <td class="text-center no-mobile @(division.BeatsMarket ? "text-success" : "")">@Html.DisplayFor(modelItem => division.LogLoss)</td>
            <td class="text-center no-mobile">@Html.DisplayFor(modelItem => division.MarketLogLoss)</td>
            <td class="text-center no-mobile">@Html.DisplayFor(modelItem => division.BrierScore)</td>
            <td class="text-center no-mobile">@division.ValueWins / @division.ValueBets</td>
            <td class="text-center @(division.ValueRoi > 0 ? "text-success" : division.ValueRoi < 0 ? "text-danger" : "")">@Html.DisplayFor(modelItem => division.ValueRoi)</td>
          </tr>
        }
    </table>

    <p class="text-muted small">
        Log loss and Brier score measure how well calibrated the probabilities are, and lower is better.
        Log loss is highlighted where it beats the bookmakers' own prices on the same matches. Value ROI
        is the return from level stakes on every selection the model priced as value &mdash; it answers a
        different question from Recommended accuracy, and today it is usually negative, so treat the Value
        signal on the Fixtures page as experimental rather than a source of picks to stake on. Hover any
        column heading for a one-line explanation.
    </p>
}
