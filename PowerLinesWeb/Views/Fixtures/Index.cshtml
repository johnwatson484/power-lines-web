@using System.Globalization
@model PowerLinesWeb.Models.FixturePage
@{
    ViewData["Title"] = "Win forecasts";
    var fixtures = Model.Fixtures.OrderBy(f => f.Date).ThenBy(f => f.FixtureId).ToList();
    var todayCount = fixtures.Count(f => f.Date.Date == Model.Today);
}
<h3>Win forecasts</h3>
<div class="d-flex flex-wrap mb-3" role="group" aria-label="Fixture day">
    @foreach (var day in fixtures.Select(f => f.Date.Date).Append(Model.Today).Distinct().Order())
    {
        var selected = day == Model.Today;
        <button type="button" class="btn @(selected ? "btn-primary" : "btn-default") date-picker mr-1 mb-1" data-date="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" aria-pressed="@selected.ToString().ToLowerInvariant()">@(selected ? "Today" : day.ToString("ddd d MMM"))</button>
    }
</div>
<details class="fixture-guide mb-3">
    <summary>About these forecasts</summary>
    <p class="small text-muted mt-2 mb-0">Power Lines picks — Strong: probability ≥ @Model.Higher.ToString("P1"). Broader: @Model.Lower.ToString("P1") ≤ probability &lt; @Model.Higher.ToString("P1"). Home/away wins only; draw risk remains included. The page shows the latest saved forecasts and picks for the whole day. Best win outcome shows the highest home/away probability independently of a Power Lines pick. Kickoff time does not change which saved forecasts, picks or prices are shown. No minimum number of picks.</p>
</details>
<p class="small">Kickoff times: @(string.IsNullOrWhiteSpace(Model.FixtureTimeZoneId) ? "timezone unverified" : Model.FixtureTimeZoneId).</p>
<div id="fixture-controls" hidden>
    <div class="fixture-controls mb-3">
        <div class="fixture-control">
            <div class="fixture-control-label" id="division-control-label">Divisions</div>
            <details class="fixture-facet">
                <summary id="division-summary" aria-labelledby="division-control-label division-summary">All divisions</summary>
                <fieldset class="fixture-options" id="division-options"><legend class="sr-only">Divisions</legend></fieldset>
            </details>
        </div>
        <div class="fixture-control">
            <div class="fixture-control-label" id="kickoff-control-label">Kickoff times</div>
            <details class="fixture-facet">
                <summary id="kickoff-summary" aria-labelledby="kickoff-control-label kickoff-summary">All kickoff times</summary>
                <fieldset class="fixture-options" id="kickoff-options"><legend class="sr-only">Kickoff times</legend></fieldset>
            </details>
        </div>
        <div class="fixture-control">
            <label class="fixture-control-label" for="minimum-probability">Minimum win probability (%)</label>
            <input id="minimum-probability" class="form-control" type="number" min="0" max="100" step="any" placeholder="Any" aria-describedby="probability-error" />
            <p id="probability-error" class="small text-danger" hidden>Enter a percentage from 0 to 100.</p>
        </div>
        <div class="fixture-control">
            <label class="fixture-control-label" for="fixture-order">Order by</label>
            <select id="fixture-order" class="form-control">
                <option value="kickoff">Kickoff time</option>
                <option value="probability">Highest win probability</option>
            </select>
        </div>
    </div>
    <p class="small text-muted mb-3">Leave divisions or kickoff times unchecked to include all.</p>
    <div class="fixture-toolbar mb-3">
        <div class="fixture-forecast-filters" role="group" aria-label="Forecast filters">
            <button type="button" class="btn btn-secondary forecast-filter" data-filter="all" aria-pressed="true">All fixtures</button>
            <button type="button" class="btn btn-outline-secondary forecast-filter" data-filter="shortlist" aria-pressed="false">Power Lines picks</button>
            <button type="button" class="btn btn-outline-secondary forecast-filter" data-filter="strong" aria-pressed="false">Strong</button>
            <button type="button" class="btn btn-outline-secondary forecast-filter" data-filter="broader" aria-pressed="false">Broader</button>
            <button type="button" class="btn btn-outline-secondary forecast-filter" data-filter="price" aria-pressed="false">Positive EV picks</button>
        </div>
        <button type="button" class="btn btn-link" id="clear-filters">Clear filters</button>
    </div>
</div>
<noscript><p>Enable JavaScript to change day, filter fixtures or change their order.</p></noscript>
<div class="fixture-results-summary mb-3">
    <p id="fixture-count" class="mb-0" role="status" aria-live="polite" aria-atomic="true">Showing @todayCount of @todayCount fixtures</p>
    <p id="active-criteria" class="small text-muted mb-0"></p>
</div>
<p id="no-fixtures" hidden="@(todayCount > 0)">No fixtures match the selected day and criteria.</p>
<div class="table-responsive">
<table id="fixture-table" class="table table-sm table-hover" hidden="@(todayCount == 0)">
    <caption class="sr-only">Daily fixtures, initially ordered by kickoff time. Saved probabilities are prematch forecasts.</caption>
    <thead><tr><th scope="col">Kickoff</th><th scope="col">Fixture</th><th scope="col">Power Lines pick</th><th scope="col">Best win outcome</th><th scope="col">Probability H / D / A</th><th scope="col">Model fair odds H / D / A</th></tr></thead>
    <tbody>
    @foreach (var f in fixtures)
    {
        var strongPick = f.HasForecast && (f.Recommended is "H" or "A");
        var broaderPick = f.HasForecast && (f.LowerRecommended is "H" or "A");
        var tier = strongPick ? "strong" : broaderPick ? "broader" : "none";
        var pick = strongPick ? f.Recommended : broaderPick ? f.LowerRecommended : null;
        var pricePick = f.HasForecast && (f.ValueSelection is "H" or "A");
        var probability = f.BestWinProbability;
        var divisionLabel = $"{f.Country} — {f.Division}";
        var kickoff = f.HasVerifiedKickoff ? f.Date.ToString("HH:mm", CultureInfo.InvariantCulture) : "unverified";
        <tr class="forecast-row" data-date="@f.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-tier="@tier" data-price="@pricePick.ToString().ToLowerInvariant()" data-fixture-id="@f.FixtureId" data-division="@f.DivisionCode" data-division-label="@divisionLabel" data-kickoff="@kickoff" data-kickoff-order="@f.Date.ToString("yyyy-MM-ddTHH:mm:ss.fffffff", CultureInfo.InvariantCulture)" data-probability="@probability?.ToString(CultureInfo.InvariantCulture)" hidden="@(f.Date.Date != Model.Today)">
            <td>
                @(f.HasVerifiedKickoff ? f.Date.ToString("dd MMM HH:mm") : $"{f.Date:dd MMM} — Time unverified")
            </td>
            <td>@f.HomeTeam v @f.AwayTeam<br /><small>@divisionLabel</small></td>
            <td class="power-lines-pick">
                @if (pick != null)
                {
                    <strong class="d-block">@(pick == "H" ? f.HomeTeam : f.AwayTeam)</strong>
                    <small class="recommendation-badge recommendation-@tier">@(strongPick ? "Strong" : "Broader")</small>
                }
                @if (pricePick)
                {
                    <div class="@(pick != null ? "mt-2" : null)">
                        <small class="recommendation-badge recommendation-price">Positive EV</small>
                        <div>@(f.ValueSelection == "H" ? f.HomeTeam : f.AwayTeam) @@ @f.ValueOdds.ToString("F2")</div>
                    </div>
                }
                @if (pick == null && !pricePick)
                {
                    <small class="text-muted">@(!f.HasForecast ? "Unavailable" : "No pick")</small>
                }
            </td>
            <td>
                @if (probability.HasValue)
                {
                    var bestTeams = f.HomeProbability == f.AwayProbability ? $"{f.HomeTeam} / {f.AwayTeam} (equal)" : f.HomeProbability > f.AwayProbability ? f.HomeTeam : f.AwayTeam;
                    <strong>@bestTeams</strong>
                    <div>@probability.Value.ToString("P1")</div>
                    <div class="win-probability" aria-hidden="true"><div style="width: @((probability.Value * 100).ToString(CultureInfo.InvariantCulture))%"></div></div>
                    @if (f.DrawProbability > probability) { <small class="d-block">Draw is more likely</small> }
                }
                else { <text>—</text> }
            </td>
            @if (f.HasForecast)
            {
                var highestProbability = new[] { f.HomeProbability, f.DrawProbability, f.AwayProbability }.Max();
                var outcomes = new[]
                {
                    (Probability: f.HomeProbability, Odds: f.HomeOdds),
                    (Probability: f.DrawProbability, Odds: f.DrawOdds),
                    (Probability: f.AwayProbability, Odds: f.AwayOdds)
                };
                <td>
                    @for (var i = 0; i < outcomes.Length; i++)
                    {
                        if (i > 0) { <text> / </text> }
                        <span class="@(outcomes[i].Probability.HasValue && outcomes[i].Probability == highestProbability ? "font-weight-bold" : null)">@(outcomes[i].Probability?.ToString("P1") ?? "—")</span>
                    }
                </td>
                <td>
                    @for (var i = 0; i < outcomes.Length; i++)
                    {
                        if (i > 0) { <text> / </text> }
                        <span class="@(outcomes[i].Probability.HasValue && outcomes[i].Probability == highestProbability ? "font-weight-bold" : null)">@(outcomes[i].Odds?.ToString("F2") ?? "—")</span>
                    }
                </td>
            }
            else
            {
            <td colspan="2" class="text-muted">@(f.Status ?? "Awaiting analysis")</td>
            }
        </tr>
    }
    </tbody>
</table>
</div>
@section scripts { <script src="~/js/fixtures.js" asp-append-version="true"></script> }
