{
  "ConnectionStrings": {
    "PowerLinesWeb": "Server=localhost;Port=5432;Database=power_lines_web;User Id=postgres;Password=postgres;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Npgsql.EntityFrameworkCore.PostgreSQL": "Critical",
      "Microsoft.EntityFrameworkCore": "Critical"
    }
  },
  "Message": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "rabbitmq",
    "Password": "rabbitmq",
    "FixtureQueue": "fixtures",
    "FixtureSubscription": "fixtures-web",
    "ResultQueue": "results",
    "ResultSubscription": "results-web"
  },
  "Threshold": {
    "Higher": 0.7,
    "Lower": 0.65,
    "Version": "win-v1-conservative"
  },
  "Model": {
    "MaxGoals": 10,
    "MinTeamMatches": 10,
    "YearsToAnalyse": 6,
    "BacktestYears": 3,
    "MaxOdds": 1000,
    "HalfLifeDays": 365,
    "PriorMatches": 5,
    "MaxIterations": 100,
    "Tolerance": 1e-06,
    "MinCalibrationPredictions": 30,
    "Version": "goals-corrected-v1",
    "HistoryStrategy": "LegacyVenue",
    "UseRho": true,
    "EnableCalibration": false
  },
  "Betting": {
    "MinEdge": 0.08,
    "KellyFraction": 0.25,
    "MinOdds": 1.2,
    "MaxOdds": 10,
    "MinExpectedReturn": 0,
    "MaxStakeFraction": 0.05,
    "MaxQuoteAgeMinutes": 30
  },
  "AllowedHosts": "*",
  "Workers": {
    "Enabled": true
  },
  "Feed": {
    "MaxResultAgeDaysInSeason": 21,
    "SeasonBreakMonths": [
      6,
      7,
      8
    ],
    "FixtureTimeZoneId": "Europe/London"
  }
}
